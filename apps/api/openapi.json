  "info": {
    "title": "LeadRadar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts/{id}/scores/{service_id}/feedback": {
      "post": {
        "description": "`API-46`: applies the api's half of [Feedback effects]\n(/architecture/rules.md#feedback-effects) to the account's lead.",
        "operationId": "post_lead_feedback_api_v1_accounts__id__scores__service_id__feedback_post",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "service_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Service Id",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leadradar Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackCreate_LeadFeedbackVerdict_"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadFeedback"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Lead Feedback",
        "tags": [
          "feedback-and-alerts"
        ]
      }
    },
    "/api/v1/findings/{id}/feedback": {
      "post": {
        "description": "`API-47`: applies the api's half of [Feedback effects]\n(/architecture/rules.md#feedback-effects) to one finding.",
        "operationId": "post_finding_feedback_api_v1_findings__id__feedback_post",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leadradar Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackCreate_FindingFeedbackVerdict_"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Finding Feedback",
        "tags": [
          "feedback-and-alerts"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "`API-61`: anonymous, `200` when the database check is `OK`, else `503`.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Health",
        "tags": [
          "audit-and-health"
        ]
      }
    },
    "/api/v1/impact": {
      "get": {
        "description": "`API-77`: computed on read by [Impact](/architecture/rules.md#impact); writes nothing.",
        "operationId": "get_impact_api_v1_impact_get",
