{
  "components": {
    "schemas": {
      "AppUserRole": {
        "description": "`app_user.role`.",
        "enum": [
          "SALES",
          "ADMIN"
        ],
        "title": "AppUserRole",
        "type": "string"
      },
      "AppUserStatus": {
        "description": "`app_user.status`.",
        "enum": [
          "ACTIVE",
          "DISABLED"
        ],
        "title": "AppUserStatus",
        "type": "string"
      },
      "AuthenticatedUser": {
        "additionalProperties": false,
        "description": "[`AuthenticatedUser`](/architecture/interfaces.md#authenticateduser).",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AppUserRole"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role"
        ],
        "title": "AuthenticatedUser",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "description": "[Health](/architecture/interfaces.md#health), the response of `API-61`.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Health",
        "type": "object"
      },
      "HealthCheckStatus": {
        "description": "One dependency's check outcome, of the [Health](/architecture/interfaces.md#health) shape.",
        "enum": [
          "OK",
          "DOWN",
          "NOT_CONFIGURED"
        ],
        "title": "HealthCheckStatus",
        "type": "string"
      },
      "HealthChecks": {
        "additionalProperties": false,
        "description": "The `checks` object of [Health](/architecture/interfaces.md#health).",
        "properties": {
          "classifier": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "database": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "embedder": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "llm": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          }
        },
        "required": [
          "database",
          "embedder",
          "classifier",
          "llm"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthStatus": {
        "description": "The overall `status` of the [Health](/architecture/interfaces.md#health) shape.",
        "enum": [
          "OK",
          "DEGRADED",
          "DOWN"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "[`LoginRequest`](/architecture/interfaces.md#loginrequest).",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "description": "[`User`](/architecture/interfaces.md#user).",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "role": {
            "$ref": "#/components/schemas/AppUserRole"
          },
          "status": {
            "$ref": "#/components/schemas/AppUserStatus"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "status",
          "last_login_at"
        ],
        "title": "User",
        "type": "object"
      },
      "UserCreate": {
        "additionalProperties": false,
        "description": "[`UserCreate`](/architecture/interfaces.md#usercreate). `password`'s `PASSWORD_MIN_LENGTH`\nis enforced once, by `auth.users.create_user` (its one owner), not a static `Field`\nconstraint: the minimum is a runtime setting, and a model built inside a router factory\ncannot be resolved by FastAPI's OpenAPI generation (`from __future__ import annotations`\nturns the route's own annotation into a forward reference that must be a module-level\nname).",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "role": {
            "$ref": "#/components/schemas/AppUserRole"
          }
        },
        "required": [
          "email",
          "display_name",
          "role",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserUpdate": {
        "additionalProperties": false,
        "description": "[`UserUpdate`](/architecture/interfaces.md#userupdate). `password`'s `PASSWORD_MIN_LENGTH`\nis enforced once, by `auth.users.update_user` (`UserCreate`'s note).",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "password": {
            "anyOf": [
              {
                "format": "password",
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AppUserRole"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AppUserStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LeadRadar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "authentication-and-users"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "parameters": [
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": true,
            "schema": {
              "title": "Leadradar Session",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "authentication-and-users"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leadradar Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Me",
        "tags": [
          "authentication-and-users"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "`API-61`: anonymous, `200` when the database check is `OK`, else `503`.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Health",
        "tags": [
          "audit-and-health"
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "get_users_api_v1_users_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leadradar Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/User"
                  },
                  "title": "Response Get Users Api V1 Users Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Users",
        "tags": [
          "authentication-and-users"
        ]
      },
      "post": {
        "operationId": "create_user_route_api_v1_users_post",
        "parameters": [
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leadradar Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create User Route",
        "tags": [
          "authentication-and-users"
        ]
      }
    },
    "/api/v1/users/{user_id}": {
      "patch": {
        "operationId": "update_user_route_api_v1_users__user_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "leadradar_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leadradar Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update User Route",
        "tags": [
          "authentication-and-users"
        ]
      }
    }
  }
}
