{
  "openapi": "3.1.0",
  "info": {
    "title": "LeadRadar API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "audit-and-health"
        ],
        "summary": "Get Health",
        "description": "`API-61`: anonymous, `200` when the database check is `OK`, else `503`.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scoring-configs/{config_id}/activate": {
      "post": {
        "tags": [
          "scoring"
        ],
        "summary": "API-18: Activate a DRAFT scoring config",
        "description": "[`API-18`](/architecture/interfaces.md#scoring): Admin only.\n\nActivates the target DRAFT scoring config, retires the previous ACTIVE version, and\nenqueues a RESCORE run. Returns the activated `ScoringConfig`.\n`409 CONFLICT` when the config is not DRAFT. `422` when `change_note` is missing.\n`403 FORBIDDEN` for non-Admin.",
        "operationId": "activate_scoring_config_route_api_v1_scoring_configs__config_id__activate_post",
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Config Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivationRequest": {
        "properties": {
          "change_note": {
            "type": "string",
            "title": "Change Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "change_note"
        ],
        "title": "ActivationRequest",
        "description": "`ActivationRequest`: `change_note` required."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Health",
        "description": "[Health](/architecture/interfaces.md#health), the response of `API-61`."
      },
      "HealthCheckStatus": {
        "type": "string",
        "enum": [
          "OK",
          "DOWN",
          "NOT_CONFIGURED"
        ],
        "title": "HealthCheckStatus",
        "description": "One dependency's check outcome, of the [Health](/architecture/interfaces.md#health) shape."
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "embedder": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "classifier": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "llm": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "database",
          "embedder",
          "classifier",
          "llm"
        ],
        "title": "HealthChecks",
        "description": "The `checks` object of [Health](/architecture/interfaces.md#health)."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "OK",
          "DEGRADED",
          "DOWN"
        ],
        "title": "HealthStatus",
        "description": "The overall `status` of the [Health](/architecture/interfaces.md#health) shape."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}