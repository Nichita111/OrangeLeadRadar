{
  "components": {
    "schemas": {
      "Health": {
        "additionalProperties": false,
        "description": "[Health](/architecture/interfaces.md#health), the response of `API-61`.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Health",
        "type": "object"
      },
      "HealthCheckStatus": {
        "description": "One dependency's check outcome, of the [Health](/architecture/interfaces.md#health) shape.",
        "enum": [
          "OK",
          "DOWN",
          "NOT_CONFIGURED"
        ],
        "title": "HealthCheckStatus",
        "type": "string"
      },
      "HealthChecks": {
        "additionalProperties": false,
        "description": "The `checks` object of [Health](/architecture/interfaces.md#health).",
        "properties": {
          "classifier": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "database": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "embedder": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "llm": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          }
        },
        "required": [
          "database",
          "embedder",
          "classifier",
          "llm"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthStatus": {
        "description": "The overall `status` of the [Health](/architecture/interfaces.md#health) shape.",
        "enum": [
          "OK",
          "DEGRADED",
          "DOWN"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "Impact": {
        "additionalProperties": false,
        "description": "[`Impact`](/architecture/interfaces.md#impact), the response of `API-77`.",
        "properties": {
          "accounts_refreshed": {
            "title": "Accounts Refreshed",
            "type": "integer"
          },
          "cost_per_refresh_eur": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Per Refresh Eur"
          },
          "findings_created": {
            "title": "Findings Created",
            "type": "integer"
          },
          "labelled_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labelled Items"
          },
          "manual_hours_replaced": {
            "title": "Manual Hours Replaced",
            "type": "number"
          },
          "manual_minutes_per_account": {
            "title": "Manual Minutes Per Account",
            "type": "integer"
          },
          "minutes_per_refresh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minutes Per Refresh"
          },
          "period_days": {
            "title": "Period Days",
            "type": "integer"
          },
          "precision": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision"
          },
          "refreshes": {
            "title": "Refreshes",
            "type": "integer"
          }
        },
        "required": [
          "period_days",
          "accounts_refreshed",
          "refreshes",
          "cost_per_refresh_eur",
          "minutes_per_refresh",
          "findings_created",
          "precision",
          "labelled_items",
          "manual_minutes_per_account",
          "manual_hours_replaced"
        ],
        "title": "Impact",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LeadRadar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "`API-61`: anonymous, `200` when the database check is `OK`, else `503`.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Health",
        "tags": [
          "audit-and-health"
        ]
      }
    },
    "/api/v1/impact": {
      "get": {
        "description": "`API-77`: computed on read by [Impact](/architecture/rules.md#impact); writes nothing.",
        "operationId": "get_impact_api_v1_impact_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Impact"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Impact",
        "tags": [
          "evaluation"
        ]
      }
    }
  }
}
