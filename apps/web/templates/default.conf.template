# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Proxies `/api/v1` to `API_UPSTREAM` and falls back to `index.html` for client routes
# ([frontend Design](/architecture/services/frontend.md#design)).

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/v1/ {
        proxy_pass ${API_UPSTREAM}/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Written at container start; never cached, so a restart with new keys takes effect.
    location = /config.json {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri /index.html;
    }
}
